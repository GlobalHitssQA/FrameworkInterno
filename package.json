{
	"name": "codeceptjs-tests",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"test": "npx codeceptjs run --tests --verbose",
		"test:gherkin": "npx codeceptjs run --features --grep @probando --verbose --debug",
		"test:gherkin2": "npx codeceptjs run-workers 10 --features",
		"test:workers": "npx ts-node runWorkers.ts",
		"test:ai": "npx codeceptjs run --features --grep @probando --ai",
		"test:colsubsidio:public": "cross-env PLAYWRIGHT_VIDEO=false PLAYWRIGHT_TRACE=false codeceptjs run tests/colsubsidio_public_test.ts --verbose",
		"check:colsubsidio:auth": "node -e \"const portals=process.env.COLSUBSIDIO_PORTAL?[process.env.COLSUBSIDIO_PORTAL]:['empresas','personas'];const missing=portals.flatMap(p=>['DOCUMENT','PASSWORD'].map(k=>'COLSUBSIDIO_'+p.toUpperCase()+'_'+k)).filter(k=>!process.env[k]);if(missing.length){console.error('Missing required environment variables: '+missing.join(', '));process.exit(1)}\"",
		"test:colsubsidio:auth:run": "cross-env COLSUBSIDIO_RUN_AUTH=true PLAYWRIGHT_VIDEO=false PLAYWRIGHT_TRACE=false SCREENSHOT_ON_FAIL=false codeceptjs run tests/colsubsidio_authenticated_test.ts --verbose",
		"test:colsubsidio:auth": "npm run check:colsubsidio:auth && npm run test:colsubsidio:auth:run",
		"test:colsubsidio:auth:empresas": "cross-env COLSUBSIDIO_PORTAL=empresas npm run test:colsubsidio:auth",
		"test:colsubsidio:auth:personas": "cross-env COLSUBSIDIO_PORTAL=personas npm run test:colsubsidio:auth",
		"test:colsubsidio:inventory": "codeceptjs run -c codecept.inventory.conf.ts --verbose",
		"generate:allure:workers": "allure generate ./output/allure-results-worker-* -o ./output/allure-report --clean",
		"codeceptjs": "codeceptjs run --steps",
		"codeceptjs:allure": "npx codeceptjs run --plugins allure",
		"generate:report": "allure generate allure-results",
		"generate:report:githubactions": "allure generate /home/runner/work/FrameworkInterno/FrameworkInterno/output",
		"show:report": "allure serve allure-results",
		"codeceptjs:headless": "HEADLESS=true codeceptjs run --steps",
		"codeceptjs:ui": "codecept-ui --app",
		"codeceptjs:demo": "codeceptjs run --steps -c node_modules/@codeceptjs/examples",
		"codeceptjs:demo:headless": "HEADLESS=true codeceptjs run --steps -c node_modules/@codeceptjs/examples",
		"codeceptjs:demo:ui": "codecept-ui --app  -c node_modules/@codeceptjs/examples",
		"k6:smoke": "ts-node performance/runK6.ts smoke",
		"k6:load": "ts-node performance/runK6.ts load",
		"k6:stress": "ts-node performance/runK6.ts stress",
		"k6:spike": "ts-node performance/runK6.ts spike",
		"k6:soak": "ts-node performance/runK6.ts soak",
		"k6:api": "ts-node performance/runK6.ts api",
		"k6:all": "npm run k6:smoke && npm run k6:load && npm run k6:stress && npm run k6:spike && npm run k6:api"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"./**/*.{js,jsx,ts,tsx}": [
			"npx prettier --write",
			"eslint **/*.ts --fix-dry-run"
		]
	},
	"devDependencies": {
		"@codeceptjs/configure": "^0.8.0",
		"@codeceptjs/examples": "^1.2.1",
		"@codeceptjs/ui": "^0.4.6",
		"@faker-js/faker": "^8.0.2",
		"@typescript-eslint/eslint-plugin": "^5.8.1",
		"@typescript-eslint/parser": "^5.8.1",
		"@wdio/selenium-standalone-service": "^7.4.2",
		"codeceptjs-dbhelper": "^1.2.2",
		"database-js-mysql": "^1.1.3",
		"eslint": "^7.32.0",
		"eslint-config-airbnb-base": "^14.2.1",
		"eslint-config-prettier": "^8.2.0",
		"eslint-plugin-codeceptjs": "^1.3.0",
		"eslint-plugin-import": "^2.22.1",
		"husky": "^4.2.3",
		"lint-staged": "^10.5.4",
		"prettier": "^2.2.1"
	},
	"dependencies": {
		"@ai-sdk/mistral": "^1.1.12",
		"@ai-sdk/openai": "^1.1.13",
		"@types/nodemailer": "^6.4.4",
		"ai": "^4.1.45",
		"allure-codeceptjs": "^2.15.1",
		"codeceptjs": "^3.6.10",
		"codeceptjs-chai": "^2.3.5",
		"cross-env": "^7.0.3",
		"dotenv": "^10.0.0",
		"eslint-config-airbnb": "^18.2.1",
		"nodemailer": "^6.7.2",
		"pdf-parse": "^1.1.1",
		"playwright": "^1.43.1",
		"tree-kill": "^1.2.2",
		"ts-node": "^10.4.0",
		"typescript": "^4.9.5",
		"xlsx": "^0.16.9"
	}
}
